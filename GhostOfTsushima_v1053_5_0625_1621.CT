[ENABLE]

aobscanmodule(aobCheckGearFlags,GhostOfTsushima.exe,39 9C 97 B4 06 00 00) // should be unique
alloc(newmem,$1000,aobCheckGearFlags)

label(code)
label(return)

newmem:

code:
   // RDI = "pGear"
  cmp [rdi+rdx*4+000006B4],ebx
  jg @f
   mov [rdi+rdx*4+6B4],1
  @@:
  cmp [rdi+rdx*4+000006B4],ebx
  jmp return

aobCheckGearFlags:
  jmp newmem
  nop 2
return:
registersymbol(aobCheckGearFlags)

[DISABLE]

aobCheckGearFlags:
  db 39 9C 97 B4 06 00 00

unregistersymbol(aobCheckGearFlags)
dealloc(newmem)

</AssemblerScript>
