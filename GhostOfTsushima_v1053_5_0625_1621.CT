aobscanmodule(aobWriteCamPos,GhostOfTsushima.exe,0F 11 81 50 05 00 00 48)
alloc(newmem2,$1000,aobWriteCamPos)

label(code2)
label(return2)
label(pCam)
registersymbol(pCam)
label(pCamPos)
registersymbol(pCamPos)
newmem2:

code2:
  push rax
  mov rax,[rcx]
  call [rax+18] // get RTTI descriptor
  mov rdx,1200000011C
  cmp [rax+8],rdx // our Cam?
  pop rax
  jne short @f
   mov [pCam],rcx
   cmp [pCamPos],0
   je short @f
    // do not block the write to the cam, just feed it the new position
    // otherwise the engine will get issues
    movups xmm0,[pCamPos]
    mov [pCam],rcx
  @@:
  movups [rcx+00000550],xmm0
  jmp return2
pCam:
dq 0
pCamPos:
dd 0
dd 0
dd 0
dd 0

aobWriteCamPos:
  jmp newmem2
  nop 2
return2:
registersymbol(aobWriteCamPos)


////////

globalalloc(FreeCamThread,$1000,$process)

createthread(FreeCamThread)

label(L_CamLoopInit)
label(L_CamLoop)
label(L_End)
label(bStop)
registersymbol(bStop)

FreeCamThread:
sub rsp,28
L_CamLoopInit:
  cmp byte ptr[bStop],1
  je L_End
  mov rbx,pCam
  mov rbx,[rbx]
  test rbx,rbx
  je L_CamLoopInit
  mov rsi,pCamRot
  mov rsi,[rsi]
  test rsi,rsi
  je L_CamLoopInit
  mov rax,pPlayer
  mov rax,[rax]
  test rax,rax
  je L_CamLoopInit
  mov rdi,_Vars
  lea rdi,[rdi+8] // NoClip Speed Float
  L_CamLoop:
  xorps xmm0,xmm0
  mov rax,pPlayer
  mov rax,[rax]
  // block the movement of the player, without blocking the write
  // this makes sure that the game never resets the player if it detects something unusual
  mov [rax+1E0],0 // Vel X
  mov [rax+1E4],0 // Vel Y
  ///////////////
  // prepare the boost multiplier x1 = default speed
  mov eax,1
  cvtsi2ss xmm6,eax
  shufps xmm6,xmm6,0
  ///////////////
  mov ecx,10 // VK_SHIFT
  call USER32.GetAsyncKeyState
  test eax,eax
  je short @f
   // boost multiplier x2
   addps xmm6,xmm6
  @@:
  mov ecx,57 // VK_W
  call USER32.GetAsyncKeyState
  test eax,eax
  je short @f
    movups xmm0,[rbx+550]
    movups xmm1,[rsi+100]
    movss xmm2,[rdi]
    shufps xmm2,xmm2,0
    mulps xmm2,xmm6
    mulps xmm1,xmm2
    addps xmm0,xmm1
    mov rax,pCamPos
    movups [rax],xmm0
  @@:
  mov ecx,53 // VK_S
  call USER32.GetAsyncKeyState
  test eax,eax
  je short @f
    movups xmm0,[rbx+550]
    movups xmm1,[rsi+100]
    movss xmm2,[rdi]
    shufps xmm2,xmm2,0
    mulps xmm2,xmm6
    mulps xmm1,xmm2
    subps xmm0,xmm1
    mov rax,pCamPos
    movups [rax],xmm0
  @@:
  mov ecx,45 // VK_E
  call USER32.GetAsyncKeyState
  test eax,eax
  je short @f
   movss xmm0,[rbx+558]
   addss xmm0,[rdi]
   mov rax,pCamPos
   movss [rax+8],xmm0
  @@:
  mov ecx,51 // VK_Q
  call USER32.GetAsyncKeyState
  test eax,eax
  je short @f
   movss xmm0,[rbx+558]
   subss xmm0,[rdi]
   mov rax,pCamPos
   movss [rax+8],xmm0
  @@:
  mov ecx,70 // VK_F1 Teleport
  call USER32.GetAsyncKeyState
  test eax,eax
  je short @f
   movups xmm0,[rbx+550]
   mov eax,[rbx+55C]
   mov rcx,pPlayer
   mov rcx,[rcx]
   test rcx,rcx
   je short @f
    movups [rcx+120],xmm0
    mov [rbx+12C],eax
  @@:
  mov ecx,10
  call KERNEL32.Sleep
  cmp byte ptr[bStop],1
  je short L_End
  jmp L_CamLoop
L_End:
add rsp,28
ret

align 10 00
bStop:
db 0

[DISABLE]
bStop:
db 1

aobWriteCamPos:
  db 0F 11 81 50 05 00 00

dealloc(newmem2)

unregistersymbol(*)




</AssemblerScript>
