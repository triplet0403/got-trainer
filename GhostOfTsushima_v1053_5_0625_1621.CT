[ENABLE]
local func = getAddress("aobCallAddGear")
local ins = getAddress("pGear")
local perm_gear = getAddress("[pPermGear]")
local templates = getAddress("[pTemplates]")
local vars = getAddress("_Vars")
local hashtoadd = readQword(vars+0xC)

local bTemplateFound = 0
for i=0,50000 do -- ToDo: find exact size lol
  local template = readPointer(templates+i*8)
  local hash = readQword(template)
  if hashtoadd == hash then
   bTemplateFound = 1
   local t = readSmallInteger(template+8)
   t = t + (t * 2)
   t = t +t
   local UnlockID = perm_gear+t*8+0x20
   local ID = readInteger(UnlockID)
   ID = bAnd(ID,240)
   ID = bOr(ID,2)
   writeInteger(UnlockID,ID)
   executeCodeEx(0,nil,func,ins,template,1,2,0,0)
  end
end
if (bTemplateFound == 0) then print("Error: Template With That Hash Not Found") return end


[DISABLE]

</AssemblerScript>
